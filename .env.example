# Copy to .env and adjust for your machine
DEBUG=True
SECRET_KEY=dev-only-change-me-pretty-affairs-hub
ALLOWED_HOSTS=localhost,127.0.0.1
USE_POSTGRES=False
SITE_CURRENCY=KES
SITE_CURRENCY_SYMBOL=KSh
TIME_ZONE=Africa/Nairobi
WHATSAPP_NUMBER=

# PostgreSQL (when USE_POSTGRES=True or production)
POSTGRES_DB=pretty_affairs_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Firebase (optional — leave empty until real project credentials exist)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# FIREBASE_CREDENTIALS=/absolute/path/to/serviceAccount.json

# Cloudflare (optional — Phase 1 DNS/WAF; R2 when ready)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=

# Authorized catalogue import (required for import_authorized_catalog)
CATALOG_FEED_A_URL=
CATALOG_FEED_B_URL=
