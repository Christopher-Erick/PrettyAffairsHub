# Copy to .env and adjust for your machine
DEBUG=True
SECRET_KEY=dev-only-change-me-pretty-affairs-hub
ALLOWED_HOSTS=localhost,127.0.0.1
USE_POSTGRES=False
SITE_CURRENCY=KES
SITE_CURRENCY_SYMBOL=KSh
TIME_ZONE=Africa/Nairobi
WHATSAPP_NUMBER=
# Digits only with country code, e.g. 254712345678
SITE_PHONE=
SITE_EMAIL=
SITE_INSTAGRAM=
SITE_TIKTOK=
SITE_CITY=Nairobi, Kenya
SECURITY_CONTACT_EMAIL=

# --- Email (password reset + contact replies from Store Manager) ---
# Local default: console backend (prints to the terminal).
#
# Render FREE tier blocks outbound SMTP (ports 25/465/587). Use Resend's
# HTTPS API instead — https://resend.com
#   1. Create a Resend account + API key (re_…)
#   2. On Render set:
# RESEND_API_KEY=re_xxxxxxxxx
# DEFAULT_FROM_EMAIL=Pretty Affairs Hub <onboarding@resend.dev>
# Leave EMAIL_BACKEND empty — Resend API is selected automatically.
# (Optional) You may also set EMAIL_HOST_PASSWORD=re_…; it is used as a fallback key.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Pretty Affairs Hub <onboarding@resend.dev>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Supabase (production database) ---
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Connection string from Supabase → Settings → Database → URI
# Prefer the "Transaction" pooler URI (port 6543) for the app.
# Example:
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_DB_URL=
POSTGRES_SSLMODE=require

# Discrete Postgres vars (used only when DATABASE_URL is empty and USE_POSTGRES=True)
POSTGRES_DB=pretty_affairs_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Smart cache ---
# Leave empty for local LocMem. In production set Upstash / Redis URL.
REDIS_URL=

# --- Cloudflare (DNS, edge cache, optional R2) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_BUCKET=

# Authorized catalogue import (required for import_authorized_catalog)
CATALOG_FEED_A_URL=
CATALOG_FEED_B_URL=
